# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.
# ---------------------------------------------------------------------------

# Which provider the classifier talks to.
# One of: openai | anthropic | ollama | openai_compatible
PA_PROVIDER=openai

# Model name for the chosen provider.
# Examples:
#   openai              -> gpt-4o-mini
#   anthropic           -> claude-3-5-sonnet-latest
#   ollama              -> llama3.1:8b-instruct
PA_MODEL=gpt-4o-mini

# API keys (only the one you use is required).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# For self-hosted / OpenAI-compatible servers (vLLM, LM Studio, Ollama, ...).
PA_BASE_URL=

# Generation parameters.
PA_TEMPERATURE=0
PA_MAX_TOKENS=512
PA_TIMEOUT_SECONDS=30

# Path to the policy the classifier enforces.
PA_POLICY_PATH=policy/policy_v1.yaml

# FastAPI server (used by the React dev proxy).
PA_API_HOST=127.0.0.1
PA_API_PORT=8000