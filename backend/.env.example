# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.
# ---------------------------------------------------------------------------

# Which provider the classifier talks to.
# One of: gemini | mistral | groq
PA_PROVIDER=gemini

# API keys (only the one for your chosen provider is required).
GOOGLE_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# FastAPI server. Inside Docker this MUST be 0.0.0.0 so the port is reachable
# from outside the container. For local dev, 127.0.0.1 is fine.
PA_API_HOST=0.0.0.0
PA_API_PORT=8000